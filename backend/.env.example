# SafePrompt AI Environment Configuration
# Copy this file to .env and add your Gemini API key below to enable live cloud inference
# When left blank, SafePrompt AI automatically runs in high-fidelity Offline Academic Demo Mode
GEMINI_API_KEY=""

# Application Environment
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Relative to backend directory)
DATABASE_PATH="safeprompt.db"
